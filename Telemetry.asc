// AGS Telemetry Module - Implementation
// https://github.com/pointandorclick/ags-telemetry
//
// Note: TELEMETRY_ENABLED is defined in Telemetry.ash but not visible here.
// We use a runtime check (Telemetry_SessionActive) instead.

int Telemetry_IdleSecondsThreshold;
String Telemetry_LogPath;
String Telemetry_BuildVersion;
String Telemetry_PlatformTag;

export Telemetry_IdleSecondsThreshold;
export Telemetry_LogPath;
export Telemetry_BuildVersion;
export Telemetry_PlatformTag;

bool Telemetry_SessionActive = false;
export Telemetry_SessionActive;

int _telemetry_sessionStartRaw = 0;
int _telemetry_lastTickRaw = 0;
int _telemetry_lastInputRaw = 0;
int _telemetry_idleSeconds = 0;
int _telemetry_activeSeconds = 0;
bool _telemetry_isIdle = false;
int _telemetry_bugReportCount = 0;

String _Telemetry_FormatDateTime(DateTime *dt)
{
  return String.Format("%04d-%02d-%02d %02d:%02d:%02d",
    dt.Year, dt.Month, dt.DayOfMonth, dt.Hour, dt.Minute, dt.Second);
}

String _Telemetry_FormatDate(DateTime *dt)
{
  return String.Format("%04d-%02d-%02d", dt.Year, dt.Month, dt.DayOfMonth);
}

bool _telemetry_fileChecked = false;

void _Telemetry_EnsureLogFile()
{
  if (_telemetry_fileChecked) return;
  _telemetry_fileChecked = true;

  // Check if file exists by trying to read it
  File *f = File.Open(Telemetry_LogPath, eFileRead);
  if (f != null) {
    f.Close();
    return;
  }

  // File doesn't exist - create it (eFileWrite creates directories too)
  f = File.Open(Telemetry_LogPath, eFileWrite);
  if (f != null) {
    f.Close();
  }
}

void _Telemetry_WriteLine(String line)
{
  _Telemetry_EnsureLogFile();

  File *f = File.Open(Telemetry_LogPath, eFileAppend);
  if (f == null) return;

  f.WriteRawLine(line);
  f.Close();
}

String _Telemetry_TargetTypeFromLocation(LocationType loc)
{
  if (loc == eLocationHotspot) return "hotspot";
  if (loc == eLocationObject) return "object";
  if (loc == eLocationCharacter) return "character";
  return "none";
}

String _Telemetry_ModeName(CursorMode mode)
{
  if (mode == eModeLookat) return "look";
  if (mode == eModeInteract) return "interact";
  if (mode == eModeTalkto) return "talk";
  if (mode == eModePointer) return "pointer";
  if (mode == eModeUseinv) return "useinv";
  if (mode == eModeWalkto) return "walk";
  return "other";
}

void Telemetry_StartSession()
{
  DateTime *now = DateTime.Now;
  Telemetry_SessionActive = true;
  _telemetry_sessionStartRaw = now.RawTime;
  _telemetry_lastTickRaw = now.RawTime;
  _telemetry_lastInputRaw = now.RawTime;
  _telemetry_idleSeconds = 0;
  _telemetry_activeSeconds = 0;
  _telemetry_isIdle = false;

  _Telemetry_WriteLine(String.Format("%s|session_start|date=%s",
    _Telemetry_FormatDateTime(now), _Telemetry_FormatDate(now)));

  if (Telemetry_BuildVersion != null && Telemetry_BuildVersion.Length > 0)
    _Telemetry_WriteLine(String.Format("%s|build|version=%s",
      _Telemetry_FormatDateTime(now), Telemetry_BuildVersion));

  if (Telemetry_PlatformTag != null && Telemetry_PlatformTag.Length > 0)
    _Telemetry_WriteLine(String.Format("%s|platform|tag=%s",
      _Telemetry_FormatDateTime(now), Telemetry_PlatformTag));

  _Telemetry_WriteLine(String.Format("%s|runtime|info=%s",
    _Telemetry_FormatDateTime(now), System.RuntimeInfo));
}

void Telemetry_EndSession()
{
  if (!Telemetry_SessionActive) return;

  DateTime *now = DateTime.Now;
  int sessionSeconds = now.RawTime - _telemetry_sessionStartRaw;

  _Telemetry_WriteLine(String.Format("%s|session_end|session_seconds=%d|active_seconds=%d|idle_seconds=%d",
    _Telemetry_FormatDateTime(now), sessionSeconds, _telemetry_activeSeconds, _telemetry_idleSeconds));

  Telemetry_SessionActive = false;
}

void Telemetry_Tick()
{
  if (!Telemetry_SessionActive) return;

  DateTime *now = DateTime.Now;
  int nowRaw = now.RawTime;

  if (_telemetry_lastTickRaw == 0) {
    _telemetry_lastTickRaw = nowRaw;
    return;
  }

  int delta = nowRaw - _telemetry_lastTickRaw;
  if (delta <= 0) return;

  _telemetry_lastTickRaw = nowRaw;

  bool isIdle = ((nowRaw - _telemetry_lastInputRaw) >= Telemetry_IdleSecondsThreshold);

  if (isIdle) _telemetry_idleSeconds += delta;
  else _telemetry_activeSeconds += delta;

  if (isIdle != _telemetry_isIdle)
  {
    _telemetry_isIdle = isIdle;
    _Telemetry_WriteLine(String.Format("%s|idle_state|idle=%d",
      _Telemetry_FormatDateTime(now), isIdle));
  }
}

void Telemetry_UserInput()
{
  if (!Telemetry_SessionActive) return;

  DateTime *now = DateTime.Now;
  _telemetry_lastInputRaw = now.RawTime;
}

void Telemetry_LogInventoryUseAt(int x, int y, InventoryItem *usedItem, bool usedDefaultCatchAll)
{
  if (!Telemetry_SessionActive) return;
  if (usedItem == null) return;

  LocationType loc = GetLocationType(x, y);
  String targetType = _Telemetry_TargetTypeFromLocation(loc);
  int targetId = -1;
  String targetName = "";

  if (loc == eLocationHotspot) {
    Hotspot *h = Hotspot.GetAtScreenXY(x, y);
    if (h != null) { targetId = h.ID; targetName = h.Name; }
  }
  else if (loc == eLocationObject) {
    Object *o = Object.GetAtScreenXY(x, y);
    if (o != null) { targetId = o.ID; targetName = o.Name; }
  }
  else if (loc == eLocationCharacter) {
    Character *c = Character.GetAtScreenXY(x, y);
    if (c != null) { targetId = c.ID; targetName = c.Name; }
  }

  DateTime *now = DateTime.Now;
  _Telemetry_WriteLine(String.Format("%s|inv_use|item_id=%d|item_name=%s|target_type=%s|target_id=%d|target_name=%s|default=%d|x=%d|y=%d",
    _Telemetry_FormatDateTime(now), usedItem.ID, usedItem.Name, targetType, targetId, targetName, usedDefaultCatchAll, x, y));
}

void Telemetry_LogInventoryUseInv(InventoryItem *usedItem, InventoryItem *targetItem, bool usedDefaultCatchAll)
{
  if (!Telemetry_SessionActive) return;
  if (usedItem == null || targetItem == null) return;

  DateTime *now = DateTime.Now;
  _Telemetry_WriteLine(String.Format("%s|inv_use_inv|item_id=%d|item_name=%s|target_item_id=%d|target_item_name=%s|default=%d",
    _Telemetry_FormatDateTime(now), usedItem.ID, usedItem.Name, targetItem.ID, targetItem.Name, usedDefaultCatchAll));
}

void Telemetry_LogCharacterInteraction(int x, int y, CursorMode mode, Character *target, bool usedDefaultCatchAll)
{
  if (!Telemetry_SessionActive) return;
  if (target == null) return;

  DateTime *now = DateTime.Now;
  _Telemetry_WriteLine(String.Format("%s|char_interact|mode=%s|char_id=%d|char_name=%s|default=%d|x=%d|y=%d",
    _Telemetry_FormatDateTime(now), _Telemetry_ModeName(mode), target.ID, target.Name, usedDefaultCatchAll, x, y));
}

void Telemetry_LogRoomEnter(int roomId, bool beforeFadeIn)
{
  if (!Telemetry_SessionActive) return;

  DateTime *now = DateTime.Now;
  String phase = "after_fadein";
  if (beforeFadeIn) phase = "before_fadein";
  _Telemetry_WriteLine(String.Format("%s|room_enter|room_id=%d|phase=%s",
    _Telemetry_FormatDateTime(now), roomId, phase));
}

void Telemetry_LogRoomLeave(int roomId, bool afterFadeOut)
{
  if (!Telemetry_SessionActive) return;

  DateTime *now = DateTime.Now;
  String phase = "before_fadeout";
  if (afterFadeOut) phase = "after_fadeout";
  _Telemetry_WriteLine(String.Format("%s|room_leave|room_id=%d|phase=%s",
    _Telemetry_FormatDateTime(now), roomId, phase));
}

void Telemetry_LogGameSaved(int slot)
{
  if (!Telemetry_SessionActive) return;

  DateTime *now = DateTime.Now;
  _Telemetry_WriteLine(String.Format("%s|game_saved|slot=%d",
    _Telemetry_FormatDateTime(now), slot));
}

void Telemetry_LogGameRestored(int slot)
{
  if (!Telemetry_SessionActive) return;

  DateTime *now = DateTime.Now;
  _Telemetry_WriteLine(String.Format("%s|game_restored|slot=%d",
    _Telemetry_FormatDateTime(now), slot));
}

void Telemetry_LogUnhandled(int what, int type)
{
  if (!Telemetry_SessionActive) return;

  DateTime *now = DateTime.Now;
  _Telemetry_WriteLine(String.Format("%s|unhandled|what=%d|type=%d",
    _Telemetry_FormatDateTime(now), what, type));
}

void Telemetry_LogError(String message)
{
  if (!Telemetry_SessionActive) return;

  DateTime *now = DateTime.Now;
  _Telemetry_WriteLine(String.Format("%s|error|message=%s",
    _Telemetry_FormatDateTime(now), message));
}

void Telemetry_LogEvent(String eventName, String data)
{
  if (!Telemetry_SessionActive) return;

  if (eventName == null) eventName = "";
  if (data == null) data = "";

  DateTime *now = DateTime.Now;
  _Telemetry_WriteLine(String.Format("%s|custom|event=%s|data=%s",
    _Telemetry_FormatDateTime(now), eventName, data));
}

void Telemetry_LogMilestone(String milestoneName)
{
  if (!Telemetry_SessionActive) return;

  if (milestoneName == null) milestoneName = "";

  DateTime *now = DateTime.Now;
  _Telemetry_WriteLine(String.Format("%s|milestone|name=%s",
    _Telemetry_FormatDateTime(now), milestoneName));
}

String Telemetry_LogBugReport(String description, bool cannotContinue)
{
  if (!Telemetry_SessionActive) return "";
  if (description == null) description = "";

  DateTime *now = DateTime.Now;
  _telemetry_bugReportCount++;

  // Gather game state
  int roomId = player.Room;
  int playerX = player.x;
  int playerY = player.y;
  String invItem = "";
  if (player.ActiveInventory != null) {
    invItem = player.ActiveInventory.Name;
  }
  int gameScore = game.score;

  // Generate screenshot filename (in telemetry folder)
  String screenshotFile = String.Format("$SAVEGAMEDIR$/telemetry/bug_%d_%04d%02d%02d_%02d%02d%02d.bmp",
    _telemetry_bugReportCount, now.Year, now.Month, now.DayOfMonth, now.Hour, now.Minute, now.Second);

  // Save screenshot
  SaveScreenShot(screenshotFile);

  _Telemetry_WriteLine(String.Format("%s|bug_report|blocking=%d|room=%d|x=%d|y=%d|score=%d|active_inv=%s|screenshot=%s|description=%s",
    _Telemetry_FormatDateTime(now), cannotContinue, roomId, playerX, playerY, gameScore, invItem, screenshotFile, description));

  return screenshotFile;
}

// Default configuration - override in your game's GlobalScript.asc
void TelemetryConfig_Init()
{
  Telemetry_IdleSecondsThreshold = 60;
  Telemetry_LogPath = "$SAVEGAMEDIR$/telemetry/telemetry.log";
  Telemetry_BuildVersion = VERSION;  // Uses VERSION defined in your project
  Telemetry_PlatformTag = "";   // Optional: "windows", "mac", "linux", etc.
}

export TelemetryConfig_Init;
